  "stage0": {
    "model_path": "models/stage0_selector_224.onnx",
    "input_name": "images",
    "output_name": "output0",
    "input_size": 224,
    "classes": [
      "steel_sheet",
      "aluminium",
      "weld",
      "casting",
      "machined_part",
      "not_metal"
    ],
    "confidence_threshold": 0.45,
    "not_metal_threshold": 0.55,
    "low_confidence_patchcore_trigger": 0.6,
    "visual_gate": {
      "enabled": true,
      "saturation_pixel_threshold": 65,
      "frame_max_mean_s": 54.0,
      "frame_max_colorful_ratio": 0.35
    }
  },
  "vision": {
    "ort_intra_op_threads": 0,
    "hef_path": "models/unified_yolo11_640.hef",
    "onnx_path": "models/unified_yolo11_640.onnx",
    "hailo_device_node": "/dev/hailo0",
    "input_name": "images",
    "output_name": "output0",
    "input_size": 640,
    "num_classes": 8,
    "num_anchors": 8400,
    "conf_threshold": 0.28,
    "nms_iou_threshold": 0.45,
    "lock_in_frames": 4,
    "tiling": {
      "enabled": true,
      "grid": [
        2,
        2
      ],
      "tile_size": 640,
      "overlap": 0.2,
      "include_full_frame": true,
      "cross_tile_nms_iou": 0.45
    },
    "metallic_surface_gate": {
      "saturation_pixel_threshold": 65,
      "box_max_mean_s": 46.0,
      "box_max_colorful_ratio": 0.25,
      "frame_max_mean_s": 54.0,
      "frame_max_colorful_ratio": 0.35
    }
  },
  "patchcore": {
    "enabled": true,
    "reference_limit_per_family": 20,
    "anomaly_threshold": 0.58,
    "refs_dir": "models/patchcore_refs",
    "banks_dir": "models/patchcore_banks",
    "families": [
      "steel_sheet",
      "aluminium",
      "weld",
      "casting",
      "machined_part"
    ],
    "always_score_families": [
      "casting",
      "machined_part"
    ],
    "low_confidence_trigger": 0.6
  },
  "llm": {
    "pte_path": "models/Llama-3.2-1B-UnifiedQC-FT-INT4.pte",
    "tokenizer_path": "models/tokenizer.model",
    "temperature": 0.0,
    "seq_len": 256,
    "max_new_tokens": 150,
    "cpu_threads": 4,
    "system_prompt": "Industrial Metal QC AI. Write two full detailed technical sentences each (plain text): Possible Cause: <physics, material stress, process trigger> | Recommended Action: <containment, machine fix, verification>"
  }
