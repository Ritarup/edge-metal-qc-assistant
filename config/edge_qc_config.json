      "steel_sheet": {
        "display_name": "Rolled Steel Sheet",
        "patchcore_always": false,
        "default_conf_threshold": 0.28
      },
      "aluminium": {
        "display_name": "Aluminium Sheet / Extrusion",
        "patchcore_always": false,
        "default_conf_threshold": 0.28
      },
      "weld": {
        "display_name": "Weld Seam / Joint",
        "patchcore_always": false,
        "default_conf_threshold": 0.26
      },
      "casting": {
        "display_name": "Metal Casting",
        "patchcore_always": true,
        "default_conf_threshold": 0.28
      },
      "machined_part": {
        "display_name": "Precision Machined Part",
        "patchcore_always": true,
        "default_conf_threshold": 0.28
      },
      "not_metal": {
        "display_name": "Non-Metal / Reject Gate",
        "patchcore_always": false,
        "default_conf_threshold": 1.0
      }
    }
